                "warmup_duration": 60,
                "benchmark_duration": 30,
                "benchmark_iterations": 10
            }
        },
        "onStop": {
            "enabled": false,
            "save_stats": false,
            "scenario_actions": [ {"id": 100} ]
        }
    },
    "contexts": {
        "Context-1": {
            "enabled": true,
